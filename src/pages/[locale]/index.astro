---
import HomePage from '@/components/pages/HomePage.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { LOCALES, type Locale } from '@/i18n/config';
import { home } from '@/i18n/pages/home';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const copy = home[locale];
---

<SiteLayout locale={locale} page="home" title={copy.title} description={copy.description}>
  <HomePage {locale} />
</SiteLayout>
