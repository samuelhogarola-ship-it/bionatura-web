---
import PageScaffold from '@/components/pages/PageScaffold.astro';
import CatalogPage from '@/components/catalog/CatalogPage.astro';
import AboutPage from '@/components/pages/AboutPage.astro';
import ContactPage from '@/components/pages/ContactPage.astro';
import GalleryPage from '@/components/pages/GalleryPage.astro';
import LegalPage from '@/components/pages/LegalPage.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { LOCALES, PAGE_KEYS, routes, type Locale, type PageKey } from '@/i18n/config';
import { pages } from '@/i18n/pages';

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    PAGE_KEYS.filter((page) => page !== 'home').map((page) => ({
      params: { locale, slug: routes[page][locale] },
      props: { locale, page },
    })),
  );
}

const { locale, page } = Astro.props as { locale: Locale; page: PageKey };
const copy = pages[page][locale];
---

<SiteLayout locale={locale} page={page} title={copy.title} description={copy.description} breadcrumbLabel={copy.h1}>
  {page === 'catalog' ? <CatalogPage {locale} /> : page === 'gallery' ? <GalleryPage {locale} /> : page === 'about' ? <AboutPage {locale} /> : page === 'contact' ? <ContactPage {locale} /> : ['legalNotice','privacy','cookies'].includes(page) ? <LegalPage {locale} {page} {copy} /> : <PageScaffold copy={copy} locale={locale} />}
</SiteLayout>
