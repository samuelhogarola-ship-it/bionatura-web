---
import Header from '@/components/navigation/Header.astro';
import Footer from '@/components/navigation/Footer.astro';
import SeoHead from '@/components/SeoHead.astro';
import OrderList from '@/components/order/OrderList.astro';
import FloatingWhatsApp from '@/components/order/FloatingWhatsApp.astro';
import MascotWelcome from '@/components/brand/MascotWelcome.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import StructuredData from '@/components/StructuredData.astro';
import '@/styles/global.css';
import '@/styles/components.css';
import type { Locale, PageKey, SeoAlternate } from '@/i18n/config';

interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description: string;
  breadcrumbLabel?: string;
  image?: string;
  canonicalPath?: string;
  alternates?: SeoAlternate[];
  ogType?: string;
  publishedAt?: string;
  modifiedAt?: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const { locale, page, title, description, breadcrumbLabel, image, canonicalPath, alternates, ogType, publishedAt, modifiedAt, breadcrumbs } = Astro.props;
const current = breadcrumbLabel ?? title.split('|')[0].trim();
const skipLabel: Record<Locale, string> = {
  es: 'Saltar al contenido',
  en: 'Skip to content',
  fi: 'Siirry sisältöön',
  da: 'Gå til indhold',
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <SeoHead {locale} {page} {title} {description} {image} {canonicalPath} {alternates} {ogType} {publishedAt} {modifiedAt} />
    <StructuredData {locale} {page} {current} {canonicalPath} {breadcrumbs} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{skipLabel[locale]}</a>
    <Header {locale} {page} links={alternates} />
    <Breadcrumbs {locale} {page} {current} items={breadcrumbs} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <OrderList {locale} />
    <MascotWelcome {locale} />
    <Footer {locale} />
    <FloatingWhatsApp {locale} />
    <script src="../scripts/order-controller.ts"></script>
  </body>
</html>
