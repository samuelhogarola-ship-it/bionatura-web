---
import { pathFor, type Locale, type PageKey } from '@/i18n/config';
import type { PageCopy } from '@/i18n/pages/types';

interface Props {
  copy: PageCopy;
  locale: Locale;
  page: PageKey;
}

const { copy, locale, page } = Astro.props;
const ctaPage: PageKey = page === 'home' || page === 'gallery' ? 'catalog' : page === 'contact' || page === 'about' || page === 'legalNotice' || page === 'privacy' || page === 'cookies' ? 'home' : 'contact';
---

<main>
  <h1>{copy.h1}</h1>
  <p>{copy.intro}</p>
  {copy.sections.map((section) => (
    <section>
      <h2>{section.title}</h2>
      <p>{section.body}</p>
    </section>
  ))}
  <a href={pathFor(locale, ctaPage)}>{copy.cta}</a>
</main>
