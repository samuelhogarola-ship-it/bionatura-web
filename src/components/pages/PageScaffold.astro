---
import { pathFor, type Locale } from '@/i18n/config';
import type { PageCopy } from '@/i18n/pages/types';

interface Props {
  copy: PageCopy;
  locale: Locale;
}

const { copy, locale } = Astro.props;
---

<article class="editorial-page">
  <div class="page-shell">
    <p class="editorial-page__eyebrow">Bionatura · Fuengirola</p>
    <h1>{copy.h1}</h1>
    <p class="editorial-page__intro">{copy.intro}</p>
    <div class="editorial-page__sections">
      {copy.sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          <p>{section.body}</p>
        </section>
      ))}
    </div>
    <p class="editorial-page__cta">
      <a class="button button--leaf" href={pathFor(locale, copy.ctaPage)}>{copy.cta}</a>
    </p>
  </div>
</article>
