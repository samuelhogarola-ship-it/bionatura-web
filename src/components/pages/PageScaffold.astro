---
import { pathFor, type Locale } from '@/i18n/config';
import type { PageCopy } from '@/i18n/pages/types';

interface Props {
  copy: PageCopy;
  locale: Locale;
}

const { copy, locale } = Astro.props;
---

<main>
  <h1>{copy.h1}</h1>
  <p>{copy.intro}</p>
  {copy.sections.map((section) => (
    <section>
      <h2>{section.title}</h2>
      <p>{section.body}</p>
    </section>
  ))}
  <a href={pathFor(locale, copy.ctaPage)}>{copy.cta}</a>
</main>
