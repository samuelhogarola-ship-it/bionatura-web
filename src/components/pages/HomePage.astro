---
import ResponsiveImage from '@/components/media/ResponsiveImage.astro';
import Mascot from '@/components/brand/Mascot.astro';
import heroAsset from '@/assets/media/garden-mixed-leaf-rows-hero-2k.png';
import { editorialItems, editorialPath } from '@/data/editorial';
import { mediaItems } from '@/data/media';
import { pathFor, type Locale } from '@/i18n/config';
import { home } from '@/i18n/pages/home';
const { locale } = Astro.props as { locale: Locale };
const copy = home[locale];
const c = {
  es: { season:'La temporada, ahora', seasonBody:'La selección cambia con el momento del año. El catálogo es orientativo y confirmamos cada disponibilidad.', seasonMascot:'Mira lo que está ahora de temporada.', process:'Del catálogo a tu cesta', steps:['Explora los productos','Prepara una cesta sin compromiso','Confirma disponibilidad y acuerda la recogida'], garden:'Nuestro huerto', gardenBody:'Cultivamos en Los Pacos y compartimos novedades, fotos y recetas en Huerto y recetas.', guide:'Ver Huerto y recetas', contact:'Hablamos antes de la recogida', contactBody:'Escríbenos o llama al 635 648 872. Cultivamos en el campo de Los Pacos y acordamos contigo la recogida después de verificar la disponibilidad.', order:'Prepara tu pedido', catalog:'Ver catálogo', notice:'Productos, cantidades y disponibilidad son orientativos hasta recibir confirmación.', basketMascot:'¿Preparamos tu cesta?' },
  en: { season:'The season, now', seasonBody:'The selection changes through the year. The catalog is a guide and each item is confirmed.', seasonMascot:'See what is in season now.', process:'From catalog to your basket', steps:['Explore the products','Prepare a no-obligation basket','Confirm availability and arrange collection'], garden:'Our garden', gardenBody:'We grow in Los Pacos and share updates, photos and recipes in Garden & recipes.', guide:'Open Garden & recipes', contact:'We talk before collection', contactBody:'Contact details, opening times and the collection point are pending confirmation. Collection is arranged after availability is checked.', order:'Prepare your order', catalog:'View catalog', notice:'Products, quantities and availability are indicative until confirmed.', basketMascot:'Shall we prepare your basket?' },
  fi: { season:'Kausi juuri nyt', seasonBody:'Valikoima muuttuu vuoden mittaan. Luettelo on ohjeellinen ja jokainen saatavuus vahvistetaan.', seasonMascot:'Katso, mikä on nyt sesongissa.', process:'Luettelosta koriisi', steps:['Tutustu tuotteisiin','Kokoa sitoumukseton kori','Vahvista saatavuus ja sovi noudosta'], garden:'Puutarhamme', gardenBody:'Viljelemme Los Pacosissa ja jaamme uutisia, kuvia ja reseptejä Puutarha ja reseptit -osiossa.', guide:'Avaa Puutarha ja reseptit', contact:'Keskustelemme ennen noutoa', contactBody:'Yhteystiedot, aukioloajat ja noutopaikka odottavat vahvistusta. Noudosta sovitaan saatavuuden tarkistamisen jälkeen.', order:'Kokoa tilauslistasi', catalog:'Katso tuotteet', notice:'Tuotteet, määrät ja saatavuus ovat ohjeellisia, kunnes ne vahvistetaan.', basketMascot:'Kootaanko kori?' },
  da: { season:'Sæsonen lige nu', seasonBody:'Udvalget skifter gennem året. Kataloget er vejledende, og hver tilgængelighed bekræftes.', seasonMascot:'Se, hvad der er i sæson nu.', process:'Fra katalog til din kurv', steps:['Se varerne','Lav en uforpligtende kurv','Bekræft tilgængelighed og aftal afhentning'], garden:'Vores have', gardenBody:'Vi dyrker i Los Pacos og deler nyt, billeder og opskrifter i Have og opskrifter.', guide:'Åbn Have og opskrifter', contact:'Vi taler sammen før afhentning', contactBody:'Kontaktoplysninger, åbningstider og afhentningssted afventer bekræftelse. Afhentning aftales, efter tilgængeligheden er kontrolleret.', order:'Forbered din bestillingsliste', catalog:'Se katalog', notice:'Varer, mængder og tilgængelighed er vejledende, indtil de bekræftes.', basketMascot:'Skal vi gøre din kurv klar?' },
}[locale];
const hero = mediaItems.find((item) => item.id === 'mixed-leaf-rows')!;
const gardenPhoto = mediaItems.find((item) => item.id === 'grower-greenhouse')!;
const featuredGuide = editorialItems.find((item) => item.id === 'seasonal-produce-fuengirola')!;
---
<article class="home-page">
  <section class="home-hero">
    <ResponsiveImage src={heroAsset} alt={hero.alt[locale]} sizes="(min-width: 64rem) 1536px, 100vw" priority />
    <div class="home-hero__copy page-shell"><p>Bionatura · Fuengirola</p><h1>{copy.h1}</h1><p>{copy.intro}</p><div><a class="button button--leaf" href={pathFor(locale,'catalog')}>{c.order}</a><a class="button" href={pathFor(locale,'catalog')}>{c.catalog}</a></div></div>
  </section>
  <section class="home-section home-season page-shell">
    <div>
      <p class="eyebrow">{c.season}</p>
      <h2>{c.season}</h2>
      <p>{c.seasonBody}</p>
      <a class="button button--leaf" href={pathFor(locale, 'catalog')}>{c.catalog}</a>
    </div>
    <Mascot locale={locale} context="season" message={c.seasonMascot} />
  </section>
  <section class="home-section home-process"><div class="page-shell home-process__layout"><div><h2>{c.process}</h2><ol>{c.steps.map((step,index)=><li><span>{index+1}</span>{step}</li>)}</ol></div><Mascot locale={locale} context="order" message={c.basketMascot} /></div></section>
  <section class="home-garden"><div class="page-shell home-garden__layout"><div><p class="eyebrow">Bionatura · Los Pacos</p><h2>{c.garden}</h2><p>{c.gardenBody}</p><a href={editorialPath(locale, featuredGuide)}>{c.guide}</a></div><ResponsiveImage src={gardenPhoto.asset} alt={gardenPhoto.alt[locale]} sizes="(min-width: 48rem) 34rem, 100vw" /></div></section>
  <section class="home-section home-contact page-shell"><h2>{c.contact}</h2><p>{c.contactBody}</p></section>
  <section class="home-final"><div class="page-shell"><h2>{c.order}</h2><a class="button button--leaf" href={pathFor(locale,'catalog')}>{c.catalog}</a><p>{c.notice}</p></div></section>
</article>
