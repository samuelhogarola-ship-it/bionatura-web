---
import {pathFor,type Locale} from '@/i18n/config'; import {howItWorks} from '@/i18n/pages/how-it-works'; const {locale}=Astro.props as {locale:Locale}; const copy=howItWorks[locale]; const c={es:{steps:['Consulta el catálogo','Prepara tu lista','Envía tu consulta'],after:'Qué ocurre después',body:'Confirmamos qué productos están disponibles y acordamos contigo la recogida. La lista no es un checkout ni implica disponibilidad inmediata.'},en:{steps:['Browse the catalog','Prepare your list','Send your enquiry'],after:'What happens next',body:'We confirm which products are available and arrange collection with you. The list is not a checkout and does not imply immediate availability.'},fi:{steps:['Selaa tuotteita','Kokoa listasi','Lähetä kysely'],after:'Mitä tapahtuu seuraavaksi',body:'Vahvistamme saatavilla olevat tuotteet ja sovimme noudosta. Lista ei ole verkkokaupan kassatoiminto eikä takaa välitöntä saatavuutta.'},da:{steps:['Se kataloget','Lav din liste','Send din forespørgsel'],after:'Hvad sker der bagefter',body:'Vi bekræfter, hvilke varer der er tilgængelige, og aftaler afhentning. Listen er ikke en checkout og betyder ikke øjeblikkelig tilgængelighed.'}}[locale];
---
<article class="editorial-page"><div class="page-shell"><h1>{copy.h1}</h1><p class="editorial-page__intro">{copy.intro}</p><ol class="steps">{c.steps.map((step,index)=><li><span>{index+1}</span><h2>{step}</h2></li>)}</ol><section class="after"><h2>{c.after}</h2><p>{c.body}</p></section><a class="button button--leaf" href={pathFor(locale,'catalog')}>{copy.cta}</a></div></article>
