---
import {business} from '@/data/business'; import {pathFor,type Locale} from '@/i18n/config'; import {contact} from '@/i18n/pages/contact'; const {locale}=Astro.props as {locale:Locale}; const copy=contact[locale]; const pending={es:'Pendiente de confirmar',en:'Pending confirmation',fi:'Odottaa vahvistusta',da:'Afventer bekræftelse'}[locale]; const labels={es:['WhatsAppApp','Teléfono','Correo','Horario','Recogida acordada'],en:['WhatsApp','Phone','Email','Opening times','Arranged collection'],fi:['WhatsApp','Puhelin','Sähköposti','Aukioloajat','Sovittu nouto'],da:['WhatsApp','Telefon','E-mail','Åbningstider','Aftalt afhentning']}[locale];
---
<article class="editorial-page contact-page"><div class="page-shell"><h1>{copy.h1}</h1><p class="editorial-page__intro">{copy.intro}</p><div class="pending-fields">{labels.map((label)=><section><h2>{label}</h2><p>{pending}</p></section>)}</div><p>{locale==='es'?'La disponibilidad y la recogida se confirman en una conversación; todavía no publicamos un punto de entrega.':copy.sections[0].body}</p><a class="button button--leaf" href={pathFor(locale,'catalog')}>{copy.cta}</a></div></article>
