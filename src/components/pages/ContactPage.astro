---
import { business } from '@/data/business';
import { pathFor, type Locale } from '@/i18n/config';
import { contact } from '@/i18n/pages/contact';

const { locale } = Astro.props as { locale: Locale };
const copy = contact[locale];
const pending = {
  es: 'Pendiente de confirmar',
  en: 'Pending confirmation',
  fi: 'Odottaa vahvistusta',
  da: 'Afventer bekræftelse',
}[locale];
const labels = {
  es: { phone: 'Teléfono', whatsapp: 'WhatsApp', email: 'Correo', hours: 'Horario', pickup: 'Zona de cultivo y recogida' },
  en: { phone: 'Phone', whatsapp: 'WhatsApp', email: 'Email', hours: 'Opening times', pickup: 'Growing and collection area' },
  fi: { phone: 'Puhelin', whatsapp: 'WhatsApp', email: 'Sähköposti', hours: 'Aukioloajat', pickup: 'Viljely- ja noutoalue' },
  da: { phone: 'Telefon', whatsapp: 'WhatsApp', email: 'E-mail', hours: 'Åbningstider', pickup: 'Dyrknings- og afhentningsområde' },
}[locale];
const phoneDisplay = '635 648 872';
const whatsappHref = `https://wa.me/${business.whatsapp.value?.replace(/\D/g, '')}`;
---

<article class="editorial-page contact-page">
  <div class="page-shell">
    <h1>{copy.h1}</h1>
    <p class="editorial-page__intro">{copy.intro}</p>
    <div class="pending-fields contact-fields">
      <section>
        <h2>{labels.phone}</h2>
        <p><a href={`tel:${business.phone.value}`}>{phoneDisplay}</a></p>
      </section>
      <section>
        <h2>{labels.whatsapp}</h2>
        <p><a href={whatsappHref} target="_blank" rel="noopener noreferrer">{phoneDisplay}</a></p>
      </section>
      <section>
        <h2>{labels.email}</h2>
        <p>{pending}</p>
      </section>
      <section>
        <h2>{labels.hours}</h2>
        <p>{pending}</p>
      </section>
      <section>
        <h2>{labels.pickup}</h2>
        <p>{locale === 'es' ? 'Campo de Los Pacos, Fuengirola. Recogida acordada previamente.' : copy.sections[0].body}</p>
      </section>
    </div>
    <p>{copy.sections[0].body}</p>
    <a class="button button--leaf" href={pathFor(locale, 'catalog')}>{copy.cta}</a>
  </div>
</article>
