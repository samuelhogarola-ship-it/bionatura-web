---
import ResponsiveImage from '@/components/media/ResponsiveImage.astro';
import { mediaItems } from '@/data/media';
import { pathFor, type Locale } from '@/i18n/config';
import { about } from '@/i18n/pages/about';

const {locale}=Astro.props as {locale:Locale}; const copy=about[locale]; const photos=mediaItems.filter((i)=>['grower-greenhouse','market-stall-team'].includes(i.id));
const aboutCopy = {
  es: {
    eyebrow: 'Bionatura · negocio local en Fuengirola',
    intro: 'Bionatura es un negocio familiar con muchos años de trayectoria en productos biológicos, centrado en atender el mercado local y cuidar cada pedido de forma directa.',
    paragraphs: [
      'Preparamos pedidos de fruta y verdura biológica para recoger y hacemos reparto local en Fuengirola, Torreblanca y Carvajal.',
      'Elige lo que quieres directamente de nuestro huerto o de proveedores biológicos de confianza. Producto fresco, trato cercano y una cesta preparada después de confirmar disponibilidad.',
    ],
    facts: ['Fuengirola, Torreblanca y Carvajal', 'Fruta y verdura a domicilio', 'Pedidos para recoger', 'Producto biológico y de cercanía'],
    cta: 'Pide ahora',
  },
  en: {
    eyebrow: 'Bionatura · local business in Fuengirola',
    intro: 'Bionatura is a family business with many years of experience in organic produce, focused on the local market and direct personal service.',
    paragraphs: [
      'We prepare organic fruit and vegetable orders for collection and local delivery in Fuengirola, Torreblanca and Carvajal.',
      'Choose what you want directly from our garden or trusted organic suppliers, with availability confirmed before each order is prepared.',
    ],
    facts: ['Fuengirola, Torreblanca and Carvajal', 'Fruit and vegetable delivery', 'Orders for collection', 'Organic local produce'],
    cta: 'Order now',
  },
  fi: {
    eyebrow: 'Bionatura · paikallinen yritys Fuengirolassa',
    intro: 'Bionatura on perheyritys, jolla on pitkä kokemus luomutuotteista ja joka keskittyy paikallisiin asiakkaisiin sekä henkilökohtaiseen palveluun.',
    paragraphs: [
      'Valmistamme luomuhedelmä- ja vihannestilauksia noutoon ja paikalliseen kotiinkuljetukseen Fuengirolassa, Torreblancassa ja Carvajalissa.',
      'Valitse haluamasi suoraan puutarhastamme tai luotetuilta luomutoimittajilta. Saatavuus vahvistetaan ennen tilauksen valmistelua.',
    ],
    facts: ['Fuengirola, Torreblanca ja Carvajal', 'Hedelmät ja vihannekset kotiin', 'Tilaukset noutoon', 'Paikalliset luomutuotteet'],
    cta: 'Tilaa nyt',
  },
  da: {
    eyebrow: 'Bionatura · lokal virksomhed i Fuengirola',
    intro: 'Bionatura er en familievirksomhed med mange års erfaring med økologiske produkter, det lokale marked og personlig betjening.',
    paragraphs: [
      'Vi forbereder økologiske frugt- og grøntbestillinger til afhentning og lokal levering i Fuengirola, Torreblanca og Carvajal.',
      'Vælg det, du ønsker, direkte fra vores have eller fra betroede økologiske leverandører. Tilgængelighed bekræftes før hver bestilling.',
    ],
    facts: ['Fuengirola, Torreblanca og Carvajal', 'Frugt og grønt leveret hjem', 'Bestillinger til afhentning', 'Lokale økologiske produkter'],
    cta: 'Bestil nu',
  },
}[locale];
---
<article class="editorial-page about-page">
  <div class="page-shell">
    <p class="eyebrow">{aboutCopy.eyebrow}</p>
    <h1>{copy.h1}</h1>
    <p class="editorial-page__intro">{aboutCopy.intro}</p>

    <div class="about-photos">
      {photos.map((item)=><figure><ResponsiveImage src={item.asset} alt={item.alt[locale]} /><figcaption>{item.caption[locale]}</figcaption></figure>)}
    </div>

    <section class="about-story" aria-label={copy.h1}>
      {aboutCopy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <ul class="about-facts">
      {aboutCopy.facts.map((fact) => <li>{fact}</li>)}
    </ul>

    <div class="about-actions">
      <a class="button button--leaf" href={pathFor(locale, 'catalog')}>{aboutCopy.cta}</a>
    </div>
  </div>
</article>
