---
import {business} from '@/data/business'; import {pathFor,type Locale,type PageKey} from '@/i18n/config'; import type {PageCopy} from '@/i18n/pages/types'; const {locale,page,copy}=Astro.props as {locale:Locale;page:PageKey;copy:PageCopy}; const isCookies=page==='cookies'; const legal={es:{identity:'Identidad jurídica',address:'Domicilio social (no es una tienda ni un punto de recogida)',scope:'Alcance',pending:'Los canales de contacto y cualquier texto que requiera validación de asesoría permanecen pendientes.',cookies:'Este MVP no instala cookies no esenciales ni analítica. Esta afirmación debe revisarse antes de publicar cualquier cambio futuro.'},en:{identity:'Legal identity',address:'Registered office (not a shop or collection point)',scope:'Scope',pending:'Contact channels and any wording requiring legal review remain pending.',cookies:'This MVP installs no non-essential cookies or analytics. This statement must be reviewed before publishing future changes.'},fi:{identity:'Oikeudellinen identiteetti',address:'Rekisteröity osoite (ei myymälä tai noutopaikka)',scope:'Soveltamisala',pending:'Yhteystiedot ja oikeudellista tarkistusta vaativa teksti odottavat vahvistusta.',cookies:'Tämä MVP ei asenna ei-välttämättömiä evästeitä tai analytiikkaa. Väite on tarkistettava ennen tulevien muutosten julkaisemista.'},da:{identity:'Juridisk identitet',address:'Registreret adresse (ikke butik eller afhentningssted)',scope:'Omfang',pending:'Kontaktkanaler og tekst, der kræver juridisk gennemgang, afventer bekræftelse.',cookies:'Denne MVP installerer ingen ikke-nødvendige cookies eller analyse. Udsagnet skal gennemgås før fremtidige ændringer offentliggøres.'}}[locale];
---
<article class="editorial-page legal-page"><div class="page-shell reading-width"><h1>{copy.h1}</h1><p>{copy.intro}</p><section><h2>{legal.identity}</h2><p><strong>{business.legalName}</strong></p><p>{business.taxId}</p><h3>{legal.address}</h3><p>{business.registeredAddress.value.street}, {business.registeredAddress.value.postalCode} {business.registeredAddress.value.locality}</p></section><section><h2>{legal.scope}</h2><p>{isCookies?legal.cookies:legal.pending}</p></section><a href={pathFor(locale,'home')}>{copy.cta}</a></div></article>
