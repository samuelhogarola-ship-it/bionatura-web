---
import type { Locale } from '@/i18n/config';
import { ui } from '@/i18n/ui';
import WhatsAppAction from './WhatsAppAction.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
---

<dialog class="order-dialog" data-order-dialog aria-labelledby="order-dialog-title">
  <div class="order-dialog__surface">
    <header class="order-dialog__header">
      <div>
        <p>{copy.orderEyebrow}</p>
        <h2 id="order-dialog-title" tabindex="-1" data-order-heading>{copy.yourList}</h2>
      </div>
      <button class="order-dialog__close" type="button" data-order-close aria-label={copy.closeList}>×</button>
    </header>

    <div class="order-dialog__content">
      <p data-order-empty>{copy.emptyList}</p>
      <ul class="order-dialog__lines" data-order-lines></ul>
      <p class="sr-only" aria-live="polite" aria-atomic="true" data-order-announcement="dialog"></p>
    </div>

    <div class="order-dialog__footer">
      <button class="button" type="button" data-order-clear>{copy.clearList}</button>
      <div class="order-dialog__confirmation" data-order-clear-confirmation hidden>
        <p>{copy.clearQuestion}</p>
        <div>
          <button class="button" type="button" data-order-clear-cancel>{copy.cancel}</button>
          <button class="button button--leaf" type="button" data-order-clear-confirm>{copy.confirmClear}</button>
        </div>
      </div>
      <WhatsAppAction {locale} />
    </div>
  </div>
</dialog>

<p class="sr-only" aria-live="polite" aria-atomic="true" data-order-announcement="page"></p>
