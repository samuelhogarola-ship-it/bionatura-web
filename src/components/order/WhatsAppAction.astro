---
import { business } from '@/data/business';
import type { ValidatedField } from '@/data/business';
import { buildWhatsAppUrl } from '@/domain/whatsapp';
import type { Locale } from '@/i18n/config';
import { ui } from '@/i18n/ui';

interface Props {
  locale: Locale;
  whatsapp?: ValidatedField<string>;
}

const { locale, whatsapp = business.whatsapp } = Astro.props;
const copy = ui[locale];
const confirmedPhone = whatsapp.status === 'confirmed' ? whatsapp.value : null;
const href = confirmedPhone ? buildWhatsAppUrl(confirmedPhone, copy.whatsappIntro) : null;
---

<div class="whatsapp-action">
  <p class="whatsapp-action__notice">{copy.availabilityNotice}</p>
  {confirmedPhone && href ? (
    <a
      class="button button--leaf"
      href={href}
      data-whatsapp-action
      data-whatsapp-phone={confirmedPhone}
      target="_blank"
      rel="noopener noreferrer"
    >{copy.consultWhatsapp}</a>
  ) : (
    <>
      <p class="whatsapp-action__demo"><strong>{copy.pendingContact}.</strong> {copy.demoCopyNotice}</p>
      <button class="button button--leaf" type="button" data-copy-order-message>{copy.copyMessage}</button>
      <textarea class="copy-fallback" readonly data-copy-fallback aria-label={copy.copyMessage} hidden></textarea>
    </>
  )}
</div>
