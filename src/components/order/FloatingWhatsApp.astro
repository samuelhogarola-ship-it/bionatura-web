---
import { business } from '@/data/business';
import { buildWhatsAppUrl } from '@/domain/whatsapp';
import { pathFor, type Locale } from '@/i18n/config';
import { ui } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const confirmed = business.whatsapp.status === 'confirmed' && business.whatsapp.value !== null;
const href = confirmed
  ? buildWhatsAppUrl(business.whatsapp.value!, ui[locale].whatsappIntro)
  : pathFor(locale, 'contact');
---

<aside aria-label={ui[locale].whatsappAccess}>
  <a
    class="floating-whatsapp"
    href={href}
    aria-label={ui[locale].whatsappAccess}
    target={confirmed ? '_blank' : undefined}
    rel={confirmed ? 'noopener noreferrer' : undefined}
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" width="25" height="25" fill="currentColor">
      <path d="M12.04 2a9.84 9.84 0 0 0-8.52 14.76L2 22l5.38-1.41A9.91 9.91 0 1 0 12.04 2Zm0 17.94a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.19.84.85-3.11-.2-.32a8.11 8.11 0 1 1 6.97 3.9Zm4.45-6.07c-.24-.12-1.44-.71-1.66-.79-.22-.08-.38-.12-.55.12-.16.24-.63.79-.77.95-.14.16-.28.18-.52.06-.24-.12-1.03-.38-1.96-1.21-.72-.65-1.21-1.45-1.35-1.69-.14-.24-.02-.37.1-.49.11-.11.25-.28.37-.43.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.43-.06-.12-.55-1.32-.75-1.81-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.43.06-.65.3-.22.24-.85.83-.85 2.03 0 1.2.87 2.36.99 2.52.12.16 1.72 2.62 4.16 3.68.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.15.2-.57.2-1.05.14-1.15-.06-.1-.22-.16-.46-.28Z" />
    </svg>
    <span class="floating-whatsapp__label">{ui[locale].whatsappAccess}</span>
  </a>
</aside>
