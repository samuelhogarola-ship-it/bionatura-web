---
import { alternateLinks, pathFor, type Locale, type PageKey, type SeoAlternate } from '@/i18n/config';
import favicon from '@/assets/brand/bionatura-logo.png';
import defaultShareImage from '@/assets/media/garden-mixed-leaf-rows-hero-2k.png';

interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description: string;
  image?: string;
  canonicalPath?: string;
  alternates?: SeoAlternate[];
  ogType?: string;
  publishedAt?: string;
  modifiedAt?: string;
}

const { locale, page, title, description, image, canonicalPath, alternates, ogType = 'website', publishedAt, modifiedAt } = Astro.props;
const base = Astro.site ?? new URL('https://bionatura.es');
const canonical = new URL(canonicalPath ?? pathFor(locale, page), base);
const faviconUrl = new URL(favicon.src, base);
const imageUrl = new URL(image ?? defaultShareImage.src, base);
const ogLocales: Record<Locale, string> = {
  es: 'es_ES',
  en: 'en_GB',
  fi: 'fi_FI',
  da: 'da_DK',
};
const localizedAlternates = alternates ?? alternateLinks(page);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" type="image/png" href={faviconUrl} />
<link rel="apple-touch-icon" href={faviconUrl} />
<link rel="canonical" href={canonical} />
{localizedAlternates.map(({ locale: hreflang, href }) => (
  <link rel="alternate" hreflang={hreflang} href={new URL(href, base)} />
))}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Bionatura" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocales[locale]} />
{Object.entries(ogLocales).filter(([key]) => key !== locale).map(([, value]) => (
  <meta property="og:locale:alternate" content={value} />
))}
<meta property="og:image" content={imageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
{publishedAt && <meta property="article:published_time" content={publishedAt} />}
{modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
