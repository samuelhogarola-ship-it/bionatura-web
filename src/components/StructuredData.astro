---
import {business} from '@/data/business'; import {pathFor,type Locale,type PageKey} from '@/i18n/config'; const {locale,page,current}=Astro.props as {locale:Locale;page:PageKey;current:string}; const base=Astro.site??new URL('https://bionatura.es'); const organization={'@context':'https://schema.org','@type':'Organization',name:business.legalName,alternateName:business.name,url:new URL('/',base).href,taxID:business.taxId,address:{'@type':'PostalAddress',streetAddress:business.registeredAddress.value.street,postalCode:business.registeredAddress.value.postalCode,addressLocality:business.registeredAddress.value.locality,addressCountry:business.registeredAddress.value.country}}; const home={es:'Inicio',en:'Home',fi:'Etusivu',da:'Forside'}[locale]; const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:home,item:new URL(pathFor(locale,'home'),base).href},...(page==='home'?[]:[{'@type':'ListItem',position:2,name:current,item:new URL(pathFor(locale,page),base).href}])]};
---
<script is:inline type="application/ld+json" set:html={JSON.stringify(organization)}></script>
<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)}></script>
