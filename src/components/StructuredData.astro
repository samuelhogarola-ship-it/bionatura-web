---
import { type Locale, type PageKey } from '@/i18n/config';
import { buildPageStructuredData } from '@/domain/structured-data';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  locale: Locale;
  page: PageKey;
  current: string;
  canonicalPath?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const { locale, page, current, canonicalPath, breadcrumbs } = Astro.props;
const schemas = buildPageStructuredData({
  locale,
  page,
  current,
  baseUrl: Astro.site ?? new URL('https://bionatura.es'),
  canonicalPath,
  breadcrumbs,
});
---

{schemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>)}
