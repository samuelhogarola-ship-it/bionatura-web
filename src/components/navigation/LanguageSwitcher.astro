---
import { alternateLinks, type Locale, type PageKey } from '@/i18n/config';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const labels: Record<Locale, string> = {
  es: 'Español',
  en: 'English',
  fi: 'Suomi',
  da: 'Dansk',
};
const languageLabel: Record<Locale, string> = {
  es: 'Idioma',
  en: 'Language',
  fi: 'Kieli',
  da: 'Sprog',
};
const links = alternateLinks(page).filter(
  (link): link is { locale: Locale; href: string } => link.locale !== 'x-default',
);
---

<div class="language-switcher">
  <label class="sr-only" for={`language-${locale}`}>{languageLabel[locale]}</label>
  <select id={`language-${locale}`} data-language-select aria-label={languageLabel[locale]}>
    {links.map((link) => (
      <option value={link.locale} data-href={link.href} selected={link.locale === locale} lang={link.locale}>
        {link.locale.toUpperCase()} · {labels[link.locale]}
      </option>
    ))}
  </select>
</div>

<script>
  for (const select of document.querySelectorAll<HTMLSelectElement>('[data-language-select]')) {
    select.addEventListener('change', () => {
      const href = select.selectedOptions[0]?.dataset.href;
      if (href) window.location.assign(href);
    });
  }
</script>
