---
import { alternateLinks, type Locale, type PageKey } from '@/i18n/config';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const labels: Record<Locale, string> = {
  es: 'Español',
  en: 'English',
  fi: 'Suomi',
  da: 'Dansk',
};
const languageLabel: Record<Locale, string> = {
  es: 'Idioma',
  en: 'Language',
  fi: 'Kieli',
  da: 'Sprog',
};
const links = alternateLinks(page).filter(
  (link): link is { locale: Locale; href: string } => link.locale !== 'x-default',
);
---

<nav class="language-switcher" aria-label={languageLabel[locale]}>
  <span class="language-switcher__label" aria-hidden="true">{locale.toUpperCase()}</span>
  <ul>
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          lang={link.locale}
          hreflang={link.locale}
          aria-current={link.locale === locale ? 'page' : undefined}
        >
          {labels[link.locale]}
        </a>
      </li>
    ))}
  </ul>
</nav>
