---
import { alternateLinks, type Locale, type PageKey } from '@/i18n/config';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const labels: Record<Locale, string> = {
  es: 'Español',
  en: 'English',
  fi: 'Suomi',
  da: 'Dansk',
};
const flags: Record<Locale, string> = {
  es: '🇪🇸',
  en: '🇬🇧',
  fi: '🇫🇮',
  da: '🇩🇰',
};
const languageLabel: Record<Locale, string> = {
  es: 'Idioma',
  en: 'Language',
  fi: 'Kieli',
  da: 'Sprog',
};
const links = alternateLinks(page).filter(
  (link): link is { locale: Locale; href: string } => link.locale !== 'x-default',
);
---

<details class="language-switcher">
  <summary role="button" aria-label={languageLabel[locale]} aria-haspopup="true" aria-expanded="false">
    <span class="language-switcher__flag" aria-hidden="true">{flags[locale]}</span>
    <span>{locale.toUpperCase()}</span>
    <svg aria-hidden="true" viewBox="0 0 12 8" width="12" height="8"><path d="m1 1 5 5 5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" /></svg>
  </summary>
  <nav aria-label={languageLabel[locale]}>
    {links.map((link) => (
      <a href={link.href} lang={link.locale} hreflang={link.locale} aria-current={link.locale === locale ? 'true' : undefined}>
        <span aria-hidden="true">{flags[link.locale]}</span>
        <span>{labels[link.locale]}</span>
      </a>
    ))}
  </nav>
</details>

<script>
  for (const switcher of document.querySelectorAll<HTMLDetailsElement>('.language-switcher')) {
    switcher.addEventListener('toggle', () => {
      switcher.querySelector('summary')?.setAttribute('aria-expanded', String(switcher.open));
    });
  }
  document.addEventListener('click', (event) => {
    for (const switcher of document.querySelectorAll<HTMLDetailsElement>('.language-switcher[open]')) {
      if (!switcher.contains(event.target as Node)) switcher.open = false;
    }
  });
</script>
