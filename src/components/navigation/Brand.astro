---
import logo from '@/assets/brand/bionatura-logo.png';
import { pathFor, type Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<a class="brand" href={pathFor(locale, 'home')} aria-label="Bionatura">
  <img src={logo.src} width="344" height="324" alt="" />
  <span class="brand__wordmark">
    <strong>Bionatura</strong>
    <small>Fuengirola · alimentos ecológicos</small>
  </span>
</a>
