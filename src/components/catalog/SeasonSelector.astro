---
import type { Locale } from '@/i18n/config';
import { ui } from '@/i18n/ui';
import type { Season } from '@/domain/catalog';
import bionaturaLogo from '@/assets/brand/bionatura-logo.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const seasons: Array<{ id: Season; symbol: string }> = [
  { id: 'spring', symbol: '✿' },
  { id: 'summer', symbol: '☀' },
  { id: 'autumn', symbol: '⌁' },
  { id: 'winter', symbol: '❄' },
];
---

<nav class="season-selector" aria-label={ui[locale].seasonNavigation} data-season-tabs data-season-style="harvest-rail">
  {seasons.map(({ id, symbol }) => (
    <button
      class="season-selector__button"
      type="button"
      id={`season-tab-${id}`}
      data-season-tab={id}
      aria-controls={`season-panel-${id}`}
    >
      <img
        class="season-selector__logo"
        src={bionaturaLogo.src}
        alt=""
        width="26"
        height="26"
        loading="lazy"
        aria-hidden="true"
      />
      <span class="season-selector__symbol" aria-hidden="true">{symbol}</span>
      <span>{ui[locale][id]}</span>
      <small data-current-season-label hidden>{ui[locale].currentSeason}</small>
    </button>
  ))}
</nav>
