---
import CatalogProductRow from './CatalogProductRow.astro';
import { editorialItems, editorialPath } from '@/data/editorial';
import { products } from '@/data/products';
import type { Locale } from '@/i18n/config';
import { pages } from '@/i18n/pages';
import { ui } from '@/i18n/ui';
import Mascot from '@/components/brand/Mascot.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = pages.catalog[locale];
const collator = new Intl.Collator(locale, { sensitivity: 'base' });
const vegetables = products.filter((product) => product.categoryId === 'vegetables').sort((a, b) => collator.compare(a.name[locale], b.name[locale]));
const fruit = products.filter((product) => product.categoryId === 'fruit').sort((a, b) => collator.compare(a.name[locale], b.name[locale]));
const extras = products.filter((product) => !['vegetables', 'fruit'].includes(product.categoryId)).sort((a, b) => collator.compare(a.name[locale], b.name[locale]));
const recipeCopy = {
  es: { heading: 'Ideas para cocinar', tomato: 'Prepara una ensalada de tomate y cebolla roja', courgette: 'Cocina calabacines mediterráneos sencillos' },
  en: { heading: 'Ideas for cooking', tomato: 'Make a tomato and red onion salad', courgette: 'Cook simple Mediterranean courgettes' },
  fi: { heading: 'Ideoita ruoanlaittoon', tomato: 'Valmista tomaatti-punasipulisalaatti', courgette: 'Kokkaa helpot välimerelliset kesäkurpitsat' },
  da: { heading: 'Idéer til madlavning', tomato: 'Lav en tomat- og rødløgssalat', courgette: 'Tilbered enkle middelhavs-squash' },
}[locale];
const deliveryCopy = {
  es: {
    eyebrow: 'A domicilio y para recoger',
    heading: 'Productos bio a domicilio y para recoger en Fuengirola',
    intro: 'Preparamos pedidos de verdura, fruta y productos bio para recoger o recibir a domicilio en Fuengirola, con envío gratuito a partir de 30 euros.',
    items: [
      'Los envíos se realizan los jueves.',
      'Para pedidos grandes o si necesitas más flexibilidad, contacta por WhatsApp.',
      'Los envíos fuera de Fuengirola también son posibles: consúltanos por WhatsApp.',
      'Trabajamos la zona de Fuengirola y Torreblanca.',
    ],
  },
  en: {
    eyebrow: 'Fruit and vegetables delivered',
    heading: 'Fruit and vegetable delivery in Fuengirola',
    intro: 'We prepare orders of vegetables, fruit and fresh produce for home delivery in Fuengirola, with free delivery from 30 euros.',
    items: [
      'Deliveries are made on Thursdays.',
      'For large orders or extra flexibility, contact us on WhatsApp.',
      'Delivery outside Fuengirola may also be possible: ask us on WhatsApp.',
      'We serve Fuengirola and Torreblanca.',
    ],
  },
  fi: {
    eyebrow: 'Hedelmät ja vihannekset kotiin',
    heading: 'Hedelmien ja vihannesten kotiinkuljetus Fuengirolassa',
    intro: 'Valmistamme vihannes-, hedelmä- ja tuoretuotetilauksia kotiinkuljetuksella Fuengirolassa, ja toimitus on ilmainen yli 30 euron tilauksille.',
    items: [
      'Toimitukset tehdään torstaisin.',
      'Suurista tilauksista tai joustavammista ajoista voit kysyä WhatsAppissa.',
      'Toimitus Fuengirolan ulkopuolelle voi myös olla mahdollista: kysy WhatsAppissa.',
      'Palvelemme Fuengirolan ja Torreblancan aluetta.',
    ],
  },
  da: {
    eyebrow: 'Frugt og grønt leveret hjem',
    heading: 'Frugt og grønt leveret hjem i Fuengirola',
    intro: 'Vi pakker bestillinger med grøntsager, frugt og friske varer til hjemmelevering i Fuengirola, med gratis levering fra 30 euro.',
    items: [
      'Leveringer sker om torsdagen.',
      'Ved store bestillinger eller behov for mere fleksibilitet, kontakt os på WhatsApp.',
      'Levering uden for Fuengirola kan også være mulig: spørg os på WhatsApp.',
      'Vi betjener Fuengirola og Torreblanca.',
    ],
  },
}[locale];
const tomatoSalad = editorialItems.find((item) => item.id === 'tomato-red-onion-salad')!;
const mediterraneanCourgettes = editorialItems.find((item) => item.id === 'simple-mediterranean-courgettes')!;
---

<article class="catalog-page" data-season-selector>
  <header class="catalog-page__hero page-shell">
    <Mascot {locale} context="catalog" />
    <div class="catalog-page__copy">
      <p class="catalog-page__eyebrow">Bionatura · Fuengirola</p>
      <h1>{copy.h1}</h1>
      <p class="catalog-page__intro">{copy.intro}</p>
    </div>
    <p class="catalog-page__notice">{ui[locale].availabilityNotice}</p>
  </header>

  <div class="page-shell">
    <section class="delivery-info" aria-labelledby="delivery-info-title">
      <p class="delivery-info__eyebrow">{deliveryCopy.eyebrow}</p>
      <div>
        <h2 id="delivery-info-title">{deliveryCopy.heading}</h2>
        <p>{deliveryCopy.intro}</p>
      </div>
      <ul>
        {deliveryCopy.items.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="complete-catalog" aria-labelledby="complete-catalog-title">
      <div class="complete-catalog__heading">
        <p class="complete-catalog__eyebrow">Bionatura · Fuengirola</p>
        <h2 id="complete-catalog-title">{ui[locale].completeCatalog}</h2>
        <p>{ui[locale].availabilityNotice}</p>
      </div>

      <section class="catalog-group" aria-labelledby="catalog-vegetables-title">
        <h2 id="catalog-vegetables-title">{ui[locale].catalogVegetables}</h2>
        <div class="catalog-directory">
          {vegetables.map((product) => <CatalogProductRow {locale} {product} />)}
        </div>
      </section>

      <section class="catalog-group" aria-labelledby="catalog-fruit-title">
        <h2 id="catalog-fruit-title">{ui[locale].catalogFruit}</h2>
        <div class="catalog-directory">
          {fruit.map((product) => <CatalogProductRow {locale} {product} />)}
        </div>
      </section>

      <section class="catalog-group" aria-labelledby="catalog-extras-title">
        <h2 id="catalog-extras-title">{ui[locale].catalogExtras}</h2>
        <div class="catalog-directory">
          {extras.map((product) => <CatalogProductRow {locale} {product} />)}
        </div>
      </section>
    </section>

    <section aria-labelledby="catalog-recipes-title">
      <h2 id="catalog-recipes-title">{recipeCopy.heading}</h2>
      <ul>
        <li><a href={editorialPath(locale, tomatoSalad)}>{recipeCopy.tomato}</a></li>
        <li><a href={editorialPath(locale, mediterraneanCourgettes)}>{recipeCopy.courgette}</a></li>
      </ul>
    </section>
  </div>
</article>
