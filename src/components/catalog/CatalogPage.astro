---
import SeasonPanel from './SeasonPanel.astro';
import SeasonSelector from './SeasonSelector.astro';
import ProductCard from './ProductCard.astro';
import { editorialItems, editorialPath } from '@/data/editorial';
import { alwaysAvailableProducts, recommendedProducts, seasonalProducts } from '@/data/products';
import type { Season } from '@/domain/catalog';
import type { Locale } from '@/i18n/config';
import { pages } from '@/i18n/pages';
import { ui } from '@/i18n/ui';
import Mascot from '@/components/brand/Mascot.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = pages.catalog[locale];
const seasons: Season[] = ['spring', 'summer', 'autumn', 'winter'];
const recipeCopy = {
  es: { heading: 'Ideas para cocinar', tomato: 'Prepara una ensalada de tomate y cebolla roja', courgette: 'Cocina calabacines mediterráneos sencillos' },
  en: { heading: 'Ideas for cooking', tomato: 'Make a tomato and red onion salad', courgette: 'Cook simple Mediterranean courgettes' },
  fi: { heading: 'Ideoita ruoanlaittoon', tomato: 'Valmista tomaatti-punasipulisalaatti', courgette: 'Kokkaa helpot välimerelliset kesäkurpitsat' },
  da: { heading: 'Idéer til madlavning', tomato: 'Lav en tomat- og rødløgssalat', courgette: 'Tilbered enkle middelhavs-squash' },
}[locale];
const tomatoSalad = editorialItems.find((item) => item.id === 'tomato-red-onion-salad')!;
const mediterraneanCourgettes = editorialItems.find((item) => item.id === 'simple-mediterranean-courgettes')!;
---

<article class="catalog-page" data-season-selector>
  <header class="catalog-page__hero page-shell">
    <Mascot {locale} context="catalog" />
    <div class="catalog-page__copy">
      <p class="catalog-page__eyebrow">Bionatura · Fuengirola</p>
      <h1>{copy.h1}</h1>
      <p class="catalog-page__intro">{copy.intro}</p>
    </div>
    <p class="catalog-page__notice">{ui[locale].availabilityNotice}</p>
  </header>

  <div class="page-shell">
    <SeasonSelector {locale} />
    <div class="season-panels">
      {seasons.map((season) => <SeasonPanel {locale} {season} products={seasonalProducts(season)} />)}
    </div>

    <section class="always-available" aria-labelledby="always-available-title">
      <h2 id="always-available-title">{ui[locale].alwaysAvailable}</h2>
      <div class="product-grid">
        {alwaysAvailableProducts().map((product) => <ProductCard {locale} {product} instanceId="regular" />)}
      </div>
    </section>

    <section class="catalog-recommendations" aria-labelledby="catalog-recommendations-title">
      <p class="catalog-recommendations__eyebrow">Bionatura · Fuengirola</p>
      <h2 id="catalog-recommendations-title">{ui[locale].recommendationHeading}</h2>
      <div class="product-grid">
        {recommendedProducts().map((product) => <ProductCard {locale} {product} instanceId="recommended" />)}
      </div>
    </section>

    <section aria-labelledby="catalog-recipes-title">
      <h2 id="catalog-recipes-title">{recipeCopy.heading}</h2>
      <ul>
        <li><a href={editorialPath(locale, tomatoSalad)}>{recipeCopy.tomato}</a></li>
        <li><a href={editorialPath(locale, mediterraneanCourgettes)}>{recipeCopy.courgette}</a></li>
      </ul>
    </section>
  </div>
</article>

<script src="../../scripts/season-selector.ts"></script>
