---
import ProductCard from './ProductCard.astro';
import ResponsiveImage from '@/components/media/ResponsiveImage.astro';
import { seasonImages } from '@/data/season-images';
import type { Locale } from '@/i18n/config';
import { ui } from '@/i18n/ui';
import type { Product, Season } from '@/domain/catalog';

interface Props {
  locale: Locale;
  season: Season;
  products: Product[];
}

const { locale, season, products } = Astro.props;
const seasonImage = seasonImages[season];
---

<section
  class="season-panel"
  id={`season-panel-${season}`}
  data-season-panel={season}
  aria-labelledby={`season-tab-${season}`}
>
  <figure class="season-panel__image">
    <ResponsiveImage
      src={seasonImage.asset}
      alt={seasonImage.alt[locale]}
      sizes="(min-width: 68rem) 72rem, 100vw"
    />
  </figure>
  <div class="season-panel__heading">
    <p>{ui[locale].seasonSelection}</p>
    <h2>{ui[locale][season]}</h2>
  </div>
  <div class="product-grid">
    {products.map((product) => <ProductCard {locale} {product} instanceId={season} />)}
  </div>
</section>
