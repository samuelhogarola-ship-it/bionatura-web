{
  "redirects": [
    { "source": "/", "destination": "/es/", "permanent": true },
    { "source": "/es/como-funciona/", "destination": "/es/catalogo/", "permanent": true },
    { "source": "/en/how-it-works/", "destination": "/en/catalog/", "permanent": true },
    { "source": "/fi/miten-se-toimii/", "destination": "/fi/tuotteet/", "permanent": true },
    { "source": "/da/saadan-fungerer-det/", "destination": "/da/katalog/", "permanent": true }
  ],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ]
  }]
}
